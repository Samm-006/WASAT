OPENROUTER_API_KEY=your_key_here

# Small model for unclear messages, large model only for hard ones.
WASAT_SMALL_MODEL=meta-llama/llama-3.2-3b-instruct
WASAT_LARGE_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: how confident the ML model must be to answer on its own (default 0.80).
# WASAT_FAST_THRESHOLD=0.80
